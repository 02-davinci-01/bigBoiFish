# ── Copy to .env.local for local dev, and set these in your host (e.g. Vercel) ──

# Visit tracking → ntfy push notification (optional; no pings if unset)
NTFY_VISIT_TOPIC=

# Upstash Redis — powers the visit counter and the site kill-switch (middleware)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
